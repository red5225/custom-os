# CustomOS boot banner lives in NOL.

fn boot() {
    print "==============================================\n";
    print "              CustomOS / NOL\n";
    print "==============================================\n";
    print "Custom kernel: ONLINE\n";
    print "NOL runtime: ONLINE\n";
    print "Linux kernel: NOT USED\n";
    print "Most OS-facing code: NOL\n";
    print "Type 'help' for commands.\n";
    call prompt;
}
