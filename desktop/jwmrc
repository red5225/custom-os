<JWM>
  <Group><Option>sticky</Option></Group>
  <Tray x="0" y="0" height="34" autohide="false">
    <TrayButton popup="Custom OS">root:1</TrayButton>
    <Spacer width="10"/>
    <Label>Custom OS</Label>
    <TaskList/>
    <Clock format="%H:%M"/>
  </Tray>
  <Tray x="0" y="-1" height="56" autohide="false">
    <Spacer width="220"/>
    <TrayButton popup="Terminal">exec:aterm -title 'Custom OS Terminal'</TrayButton>
    <TrayButton popup="Files">exec:aterm -title 'Files' -e sh</TrayButton>
    <TrayButton popup="Settings">exec:aterm -title 'Settings' -e sh</TrayButton>
    <Spacer width="220"/>
  </Tray>
  <RootMenu onroot="123">
    <Program label="Terminal">aterm</Program>
    <Program label="Files">aterm -title "Files" -e sh</Program>
    <Program label="Settings">aterm -title "Settings" -e sh</Program>
    <Separator/>
    <Restart label="Refresh Desktop"/>
    <Exit label="Log Out"/>
  </RootMenu>
</JWM>
