#!/bin/sh
case "$1" in
 start)
  echo
  echo "========================================"
  echo "       CustomOS Linux Edition"
  echo "========================================"
  echo "Kernel: Linux | Userspace: BusyBox"
  echo "Python: $(python3 --version 2>/dev/null || echo unavailable)"
  echo "Type customos help for system tools."
  echo
  ;;
 stop) ;;
 restart) "$0" stop; "$0" start ;;
 *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
