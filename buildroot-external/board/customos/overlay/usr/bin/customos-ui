#!/bin/sh
ESC="$(printf '\033')"
clear_screen() { printf '%s[2J%s[H' "$ESC" "$ESC"; }
draw_home() {
  clear_screen
  printf '%s[38;5;45m' "$ESC"
  printf '╔══════════════════════════════════════════════════════════════════════╗\n'
  printf '║  CUSTOMOS                                             MAGNETO EDITION ║\n'
  printf '╠══════════════════════════════════════════════════════════════════════╣\n'
  printf '║                                                                      ║\n'
  printf '║       CUSTOMOS  /  YOUR MACHINE. YOUR SYSTEM.                        ║\n'
  printf '║                                                                      ║\n'
  printf '╠══════════════════════════════════════════════════════════════════════╣\n'
  printf '║  1  System overview       2  Hardware / boot status                  ║\n'
  printf '║  3  Credits               4  Open maintenance terminal               ║\n'
  printf '║  5  Reboot                6  Power off                               ║\n'
  printf '║                                                                      ║\n'
  printf '║  Custom interface • Acer Chromebook CB314-3H family                 ║\n'
  printf '╚══════════════════════════════════════════════════════════════════════╝\n'
  printf '%s[0m' "$ESC"
  printf '\n  Select an option [1-6]: '
}
while :; do
  draw_home
  IFS= read -r choice || exit 0
  case "$choice" in
    1) clear_screen; echo 'CUSTOMOS / SYSTEM OVERVIEW'; echo '=========================='; uname -a; echo; echo 'CustomOS-authored interface and system branding on an upstream kernel/userspace base.'; echo 'Development build; not all Chromebook hardware is validated.'; echo; echo 'Press Enter to return.'; read -r _ ;;
    2) clear_screen; echo 'CUSTOMOS / HARDWARE AND BOOT STATUS'; echo '==================================='; echo "Architecture: $(uname -m)"; echo "Kernel:       $(uname -r)"; echo "Command line: $(cat /proc/cmdline 2>/dev/null)"; echo; echo 'QEMU boot does not prove Wi-Fi, audio, touchpad or internal storage support.'; echo; echo 'Press Enter to return.'; read -r _ ;;
    3) clear_screen; echo 'CUSTOMOS / CREDITS'; echo '=================='; echo 'Project and CustomOS interface: red5225'; echo 'Kernel, bootloader and base userspace: respective upstream projects'; echo 'Third-party components and licenses: see THIRD_PARTY.md'; echo 'Not affiliated with Acer or Google.'; echo; echo 'Press Enter to return.'; read -r _ ;;
    4) clear_screen; echo "Maintenance terminal. Type 'exit' to return."; /bin/sh ;;
    5) echo 'Rebooting...'; reboot ;;
    6) echo 'Powering off...'; poweroff ;;
    *) : ;;
  esac
done
