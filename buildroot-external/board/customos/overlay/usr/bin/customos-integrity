#!/usr/bin/env python3
"""SHA-256 verification with optional atomic restore from a trusted recovery tree."""
import hashlib, os, shutil, sys, tempfile
from pathlib import Path
def digest(path):
    h=hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda:f.read(65536),b""): h.update(block)
    return h.hexdigest()
def main():
    if len(sys.argv)<3:
        print("usage: customos-integrity MANIFEST ROOT [RECOVERY_DIR]",file=sys.stderr); return 2
    manifest,root=Path(sys.argv[1]),Path(sys.argv[2])
    recovery=Path(sys.argv[3]) if len(sys.argv)>3 else None
    if not manifest.is_file():
        print(f"integrity: manifest missing: {manifest}",file=sys.stderr); return 2
    failures=[]
    for raw in manifest.read_text(encoding="utf-8").splitlines():
        line=raw.strip()
        if not line or line.startswith("#"): continue
        try: expected,rel=line.split(None,1)
        except ValueError:
            print(f"integrity: malformed line: {raw}",file=sys.stderr); return 2
        rel=rel.lstrip("* ")
        if rel.startswith("/") or ".." in Path(rel).parts:
            print(f"integrity: unsafe path rejected: {rel}",file=sys.stderr); return 2
        target=root/rel
        if target.is_file() and digest(target)==expected:
            print(f"OK {rel}"); continue
        print(f"BAD {rel}"); failures.append((expected,rel,target))
    for expected,rel,target in failures:
        if recovery is None: continue
        source=recovery/rel
        if not source.is_file() or digest(source)!=expected:
            print(f"RECOVERY FAILED {rel}",file=sys.stderr); continue
        target.parent.mkdir(parents=True,exist_ok=True)
        fd,tmp=tempfile.mkstemp(prefix=".customos-repair-",dir=str(target.parent))
        try:
            with os.fdopen(fd,"wb") as out,source.open("rb") as inp:
                shutil.copyfileobj(inp,out); out.flush(); os.fsync(out.fileno())
            os.replace(tmp,target); print(f"RESTORED {rel}")
        finally:
            if os.path.exists(tmp): os.unlink(tmp)
    return 1 if failures else 0
if __name__=="__main__": raise SystemExit(main())
