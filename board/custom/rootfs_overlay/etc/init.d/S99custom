#!/bin/sh
case "$1" in
  start)
    clear
    printf '\033[1;36m'
    cat /usr/local/share/custom-os/boot-banner.txt 2>/dev/null || true
    printf '\033[0m\n'
    echo "  Custom OS graphical desktop"
    echo "  Python 3.14 runtime installed"
    echo
    # Launch the graphical desktop automatically as the normal Tiny Core user.
    if command -v start-desktop >/dev/null 2>&1; then
      su - tc -c '/usr/local/bin/start-desktop >/tmp/custom-desktop.log 2>&1 &' || true
    fi
    ;;
esac
exit 0
