# XCUI desktop layout source.
# Reorder app buttons here to change the desktop grid.
# The light theme uses calm neutrals, clear spacing, and one blue accent.
app "CustomOS Shell" {
    window "Desktop" background "#f5f7fb" {
        column gap 18 padding 32 {
            text "CustomOS" size 28 color "#172033"
            text "A simple desktop for your computer" size 14 color "#667085"
            panel "Your apps" width 560 background "#ffffff" {
                column gap 14 padding 22 {
                    text "PINNED" size 11 color "#64748b"
                    row gap 14 {
                        button "Files" action "open_files" height 72
                        button "Terminal" action "open_terminal" height 72
                    }
                    row gap 14 {
                        button "Settings" action "open_settings" height 72
                        button "Network" action "open_network" height 72
                    }
                    text "Choose an app to get started." size 13 color "#667085"
                }
            }
            text "CustomOS  •  Early preview" size 12 color "#98a2b3"
        }
    }
}
